{
  "name": "rusty-engine-gameplay-rules",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "tsc --build packages/gameplay-rules-contracts/tsconfig.json packages/gameplay-rules-authoring/tsconfig.json",
    "boundary": "node scripts/check-boundaries.mjs",
    "generate": "node scripts/generate-contract.mjs --write",
    "generate:check": "node scripts/generate-contract.mjs --check",
    "test": "pnpm -r test",
    "typecheck": "tsc --build packages/gameplay-rules-contracts/tsconfig.json packages/gameplay-rules-authoring/tsconfig.json",
    "verify": "pnpm run generate:check && pnpm run boundary && pnpm run typecheck && pnpm run test"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}

<Project>
  <!-- Keep bundle inventory generation in the packaged SDK. Products only
       declare their content groups; this task owns validation and inventory
       bytes after the ordinary content copy has completed. -->
  <UsingTask TaskName="RustyEngineContentBundleManifestTask"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)/Microsoft.Build.Tasks.Core.dll">
    <Task>
      <Code Type="Class" Language="cs"
            Source="$(MSBuildThisFileDirectory)Tasks/RustyEngineContentBundleManifestTask.cs" />
    </Task>
  </UsingTask>

  <!-- The product project that declares RustyEngineProductEntryType compiles
       its own bind export and debug catalog. It loads as a CoreCLR component:
       the SDK writes its runtimeconfig and copies its dependencies beside it.
       Library projects that reference Rusty.Engine are left untouched. -->
  <PropertyGroup Condition="'$(RustyEngineProductEntryType)' != ''">
    <EnableDynamicLoading Condition="'$(EnableDynamicLoading)' == ''">true</EnableDynamicLoading>
  </PropertyGroup>
  <ItemGroup Condition="'$(RustyEngineProductEntryType)' != ''">
    <CompilerVisibleProperty Include="RustyEngineProductEntryType" />
  </ItemGroup>
  <ItemGroup Condition="'$(RustyEngineUseSourceDevelopment)' != 'true' and '$(RustyEngineProductEntryType)' != ''">
    <Analyzer Include="$(MSBuildThisFileDirectory)analyzers/Rusty.Engine.ProductGenerator.dll" />
  </ItemGroup>

  <ItemGroup Condition="'$(RustyEngineUseSourceDevelopment)' == 'true' and '$(RustyEngineSourceDevelopmentPath)' != ''">
    <ProjectReference Include="$(RustyEngineSourceDevelopmentPath)/csharp/Rusty.Engine/Rusty.Engine.csproj" />
    <!-- The generator is a netstandard2.0 analyzer: a NativeAOT publish's
         global properties do not apply to it. -->
    <ProjectReference Include="$(RustyEngineSourceDevelopmentPath)/csharp/Rusty.Engine.ProductGenerator/Rusty.Engine.ProductGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false"
                      UndefineProperties="PublishAot;NativeLib;StripSymbols;RuntimeIdentifier;SelfContained"
                      Condition="'$(RustyEngineProductEntryType)' != ''" />
  </ItemGroup>

  <!-- A test project (IsTestProject) or a tool executable (RustyEngineToolHost)
       runs the Engine's services in process through
       Rusty.Engine.Testing.EngineTestHost. The library comes from the pinned
       pair's runtime pack, or the source override's pack. A test records its
       path in the runtimeconfig; a tool copies it beside its build and publish
       output and records the file name, so the published tool carries it. -->
  <PropertyGroup Condition="('$(IsTestProject)' == 'true' or '$(RustyEngineToolHost)' == 'true') and '$(RustyEngineTestHostLibrary)' == ''">
    <_RustyEngineTestHostCache>$(RustyEngineCache)</_RustyEngineTestHostCache>
    <_RustyEngineTestHostCache Condition="'$(_RustyEngineTestHostCache)' == '' and '$(XDG_CACHE_HOME)' != ''">$(XDG_CACHE_HOME)/rusty-engine</_RustyEngineTestHostCache>
    <_RustyEngineTestHostCache Condition="'$(_RustyEngineTestHostCache)' == '' and '$(HOME)' != ''">$(HOME)/.cache/rusty-engine</_RustyEngineTestHostCache>
    <_RustyEngineTestHostCache Condition="'$(_RustyEngineTestHostCache)' == ''">$(USERPROFILE)/.cache/rusty-engine</_RustyEngineTestHostCache>
    <_RustyEngineTestHostTarget>linux-x64</_RustyEngineTestHostTarget>
    <_RustyEngineTestHostTarget Condition="$([MSBuild]::IsOSPlatform('Windows'))">win-x64</_RustyEngineTestHostTarget>
    <_RustyEngineTestHostFile>librusty_engine_test_host.so</_RustyEngineTestHostFile>
    <_RustyEngineTestHostFile Condition="$([MSBuild]::IsOSPlatform('Windows'))">rusty_engine_test_host.dll</_RustyEngineTestHostFile>
    <RustyEngineTestHostLibrary Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">$(RustyEngineSourceDevelopmentPath)/target/runtime-pack/$(_RustyEngineTestHostTarget)/lib/$(_RustyEngineTestHostFile)</RustyEngineTestHostLibrary>
    <RustyEngineTestHostLibrary Condition="'$(RustyEngineUseSourceDevelopment)' != 'true'">$(_RustyEngineTestHostCache)/pairs/$(RustyEngineSdkPackageVersion)/runtime-pack/lib/$(_RustyEngineTestHostFile)</RustyEngineTestHostLibrary>
  </PropertyGroup>
  <ItemGroup Condition="'$(RustyEngineTestHostLibrary)' != '' and '$(RustyEngineToolHost)' != 'true'">
    <RuntimeHostConfigurationOption Include="Rusty.Engine.TestHostLibrary" Value="$(RustyEngineTestHostLibrary)" />
  </ItemGroup>
  <ItemGroup Condition="'$(RustyEngineTestHostLibrary)' != '' and '$(RustyEngineToolHost)' == 'true'">
    <RuntimeHostConfigurationOption Include="Rusty.Engine.TestHostLibrary" Value="$([System.IO.Path]::GetFileName('$(RustyEngineTestHostLibrary)'))" />
    <None Include="$(RustyEngineTestHostLibrary)"
          Link="$([System.IO.Path]::GetFileName('$(RustyEngineTestHostLibrary)'))"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest"
          Visible="false" />
  </ItemGroup>

  <!-- Defaults that derive from the product's own paths are set here, after
       the product project body. Edits under the UI source root, the UI root
       or a content bundle root reach a running `rusty dev` product without a
       C# build or runtime replacement. Without a build command the UI root is
       its own source. Referenced projects are added by
       _RustyEngineWatchReferencedProjects once the reference graph is known. -->
  <PropertyGroup>
    <RustyEngineProductUiSourceRoot Condition="'$(RustyEngineProductUiSourceRoot)' == ''">$(RustyEngineProductUiRoot)</RustyEngineProductUiSourceRoot>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RustyEngineWatchPaths)' == ''">
    <_RustyEngineWatchReferencedProjects>true</_RustyEngineWatchReferencedProjects>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory);$([System.IO.Path]::GetFullPath('$(RustyEngineProductUiSourceRoot)', '$(MSBuildProjectDirectory)'));$([System.IO.Path]::GetFullPath('$(RustyEngineProductContentRoot)', '$(MSBuildProjectDirectory)'))</RustyEngineWatchPaths>
  </PropertyGroup>

  <PropertyGroup>
    <_RustyEngineNativeAotOutputDirectory>$([System.IO.Path]::GetFullPath('$(RustyEngineStagedProductDirectory)/../NativeAot'))</_RustyEngineNativeAotOutputDirectory>
    <_RustyEngineProductUiBuildStamp>$([System.IO.Path]::GetFullPath('$(RustyEngineStagedProductDirectory)/../ui-build.stamp'))</_RustyEngineProductUiBuildStamp>
    <_RustyEngineProductNativeModule>$(TargetName).so</_RustyEngineProductNativeModule>
    <_RustyEngineManifestPresentationAspect Condition="'$(RustyEngineProductPresentationAspectMinimum)' != ''">,&quot;presentationAspect&quot;:{&quot;minimum&quot;:$(RustyEngineProductPresentationAspectMinimum),&quot;maximum&quot;:$(RustyEngineProductPresentationAspectMaximum)}</_RustyEngineManifestPresentationAspect>
    <_RustyEngineManifestUiProjection Condition="'$(RustyEngineProductUiProjectionStream)' != ''">,&quot;uiProjection&quot;:{&quot;expectedStream&quot;:&quot;$(RustyEngineProductUiProjectionStream)&quot;,&quot;expectedContract&quot;:&quot;$(RustyEngineProductUiProjectionContract)&quot;}</_RustyEngineManifestUiProjection>
    <!-- Keep the browser's existing neutral rig unless a product deliberately
         selects the independently configurable world or viewmodel setting. -->
    <RustyEngineProductSceneShadows Condition="'$(RustyEngineProductSceneShadows)' == ''">disabled</RustyEngineProductSceneShadows>
    <RustyEngineProductShadowBudget Condition="'$(RustyEngineProductShadowBudget)' == ''">0</RustyEngineProductShadowBudget>
    <!-- Ambient occlusion on world views: enabled (screen-space),
         distanceField or disabled, its strength (1 is the full occlusion)
         and its radius in world units. -->
    <RustyEngineProductAmbientOcclusion Condition="'$(RustyEngineProductAmbientOcclusion)' == ''">disabled</RustyEngineProductAmbientOcclusion>
    <RustyEngineProductAmbientOcclusionStrength Condition="'$(RustyEngineProductAmbientOcclusionStrength)' == ''">1</RustyEngineProductAmbientOcclusionStrength>
    <RustyEngineProductAmbientOcclusionRadius Condition="'$(RustyEngineProductAmbientOcclusionRadius)' == ''">0.75</RustyEngineProductAmbientOcclusionRadius>
    <RustyEngineProductVolumetricFog Condition="'$(RustyEngineProductVolumetricFog)' == ''">off</RustyEngineProductVolumetricFog>
    <!-- Samples per pixel of the streamed frame or the window: off, 2x or
         4x. Offscreen camera targets and image captures are single-sample. -->
    <RustyEngineProductAntialiasing Condition="'$(RustyEngineProductAntialiasing)' == ''">4x</RustyEngineProductAntialiasing>
    <!-- Window output waits for the display's refresh before presenting. -->
    <RustyEngineProductVsync Condition="'$(RustyEngineProductVsync)' == ''">enabled</RustyEngineProductVsync>
    <!-- The fraction of the frame's size the world draws at before being
         upscaled: 0.5 to 1. -->
    <RustyEngineProductRenderScale Condition="'$(RustyEngineProductRenderScale)' == ''">1</RustyEngineProductRenderScale>
    <!-- Clustered forward shading: world views bin their
         lights into a view-frustum grid and each fragment shades from its
         cluster instead of looping over every light. -->
    <RustyEngineProductClusteredLighting Condition="'$(RustyEngineProductClusteredLighting)' == ''">disabled</RustyEngineProductClusteredLighting>
    <!-- GPU visibility: each view tests its opaque parts
         against the frustum in a compute pass and draws them indirectly. -->
    <RustyEngineProductGpuCulling Condition="'$(RustyEngineProductGpuCulling)' == ''">disabled</RustyEngineProductGpuCulling>
    <RustyEngineProductDefaultWorldLights Condition="'$(RustyEngineProductDefaultWorldLights)' == ''">neutral</RustyEngineProductDefaultWorldLights>
    <RustyEngineProductDefaultViewmodelLights Condition="'$(RustyEngineProductDefaultViewmodelLights)' == ''">neutral</RustyEngineProductDefaultViewmodelLights>
    <!-- Where the runtime draws: streamed to the browser shell, or presented
         to a native window (the pair's desktop pack). The rusty dev output
         option sets it for one launch. -->
    <RustyEngineProductRenderOutput Condition="'$(RustyEngineProductRenderOutput)' == ''">stream</RustyEngineProductRenderOutput>
    <!-- Where the sound plays: streamed to the pages watching the frames, or
         on the runtime's output device, optional or required. It follows the
         render output unless set. The rusty dev audio-output option sets it
         for one launch. -->
    <RustyEngineProductAudioOutput Condition="'$(RustyEngineProductAudioOutput)' == '' and '$(RustyEngineProductRenderOutput)' == 'stream'">stream</RustyEngineProductAudioOutput>
    <RustyEngineProductAudioOutput Condition="'$(RustyEngineProductAudioOutput)' == ''">device-optional</RustyEngineProductAudioOutput>
  </PropertyGroup>

  <!-- Every file under the UI source root except the build's own output is a
       UI build input. Products add config and dependency files outside it
       (package manifest, lockfile) to the same item. -->
  <ItemGroup Condition="'$(RustyEngineProductUiBuildCommand)' != ''">
    <RustyEngineProductUiInput Include="$(RustyEngineProductUiSourceRoot)/**/*"
                               Exclude="$(RustyEngineProductUiRoot)/**/*;$(RustyEngineProductUiSourceRoot)/**/node_modules/**/*" />
  </ItemGroup>

  <!-- Product configuration checks that need no build output. The UI and
       content roots are checked where they are staged. -->
  <Target Name="ValidateRustyEngineProduct">
    <Error Condition="'$(RustyEngineProductEntryType)' == ''"
           Text="RustyEngineProductEntryType is required. Set it to the fully-qualified IEngineProduct implementation in the ordinary product project." />
    <Error Condition="('$(RustyEngineProductUiProjectionStream)' == '' and '$(RustyEngineProductUiProjectionContract)' != '') or ('$(RustyEngineProductUiProjectionStream)' != '' and '$(RustyEngineProductUiProjectionContract)' == '')"
           Text="RustyEngineProductUiProjectionStream and RustyEngineProductUiProjectionContract must be declared together." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductSceneShadows)', '\A(enabled|disabled)\z'))" Text="RustyEngineProductSceneShadows must be enabled or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductShadowBudget)', '\A[0-9]{1,6}\z'))" Text="RustyEngineProductShadowBudget must be a whole number of shadow layers (0 for no limit)." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductAmbientOcclusion)', '\A(disabled|enabled|distanceField)\z'))" Text="RustyEngineProductAmbientOcclusion must be enabled, distanceField or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductAmbientOcclusionStrength)', '\A[0-9]+(\.[0-9]+)?\z'))" Text="RustyEngineProductAmbientOcclusionStrength must be a non-negative number." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductAmbientOcclusionRadius)', '\A[0-9]+(\.[0-9]+)?\z'))" Text="RustyEngineProductAmbientOcclusionRadius must be a positive number of world units." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductVolumetricFog)', '\A(off|low|high)\z'))" Text="RustyEngineProductVolumetricFog must be off, low or high." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductAntialiasing)', '\A(off|2x|4x)\z'))" Text="RustyEngineProductAntialiasing must be off, 2x or 4x." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductVsync)', '\A(enabled|disabled)\z'))" Text="RustyEngineProductVsync must be enabled or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductRenderScale)', '\A(0\.[5-9][0-9]*|1(\.0*)?)\z'))" Text="RustyEngineProductRenderScale must be a number from 0.5 to 1." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductClusteredLighting)', '\A(enabled|disabled)\z'))" Text="RustyEngineProductClusteredLighting must be enabled or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductGpuCulling)', '\A(enabled|disabled)\z'))" Text="RustyEngineProductGpuCulling must be enabled or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductDefaultWorldLights)', '\A(neutral|disabled)\z'))"
           Text="RustyEngineProductDefaultWorldLights must be neutral or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductDefaultViewmodelLights)', '\A(neutral|disabled)\z'))"
           Text="RustyEngineProductDefaultViewmodelLights must be neutral or disabled." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductInputCursorMode)', '\A(pointer-lock|unlocked|confined)\z'))"
           Text="RustyEngineProductInputCursorMode must be pointer-lock, unlocked or confined." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductRenderOutput)', '\A(stream|window)\z'))"
           Text="RustyEngineProductRenderOutput must be stream or window." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductAudioOutput)', '\A(stream|device-optional|device-required)\z'))"
           Text="RustyEngineProductAudioOutput must be stream, device-optional or device-required." />
    <Error Condition="('$(RustyEngineProductPresentationAspectMinimum)' == '') != ('$(RustyEngineProductPresentationAspectMaximum)' == '')"
           Text="RustyEngineProductPresentationAspectMinimum and RustyEngineProductPresentationAspectMaximum must be declared together." />
    <Error Condition="'$(RustyEngineProductPresentationAspectMinimum)' != '' and (!$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductPresentationAspectMinimum)', '\A[0-9]+(\.[0-9]+)?\z')) or !$([System.Text.RegularExpressions.Regex]::IsMatch('$(RustyEngineProductPresentationAspectMaximum)', '\A[0-9]+(\.[0-9]+)?\z')))"
           Text="RustyEngineProductPresentationAspectMinimum and RustyEngineProductPresentationAspectMaximum must be decimal width-to-height ratios, such as 1.25 and 2.4." />
    <Error Condition="'$(RustyEngineProductAudioOutput)' == 'stream' and '$(RustyEngineProductRenderOutput)' != 'stream'"
           Text="RustyEngineProductAudioOutput stream needs RustyEngineProductRenderOutput stream; a window plays on its device." />
  </Target>

  <!-- The stamp lists the files the last UI build produced. When any of them
       is gone, dropping the stamp makes the next build run the command. This
       checks existence only, so a compiler that leaves unchanged modules
       untouched is not rebuilt on every C# build. -->
  <Target Name="_CheckRustyEngineProductUiOutputs"
          Condition="'$(RustyEngineProductUiBuildCommand)' != '' and Exists('$(_RustyEngineProductUiBuildStamp)')">
    <ReadLinesFromFile File="$(_RustyEngineProductUiBuildStamp)">
      <Output TaskParameter="Lines" ItemName="_RustyEngineProductUiBuiltFile" />
    </ReadLinesFromFile>
    <ItemGroup>
      <_RustyEngineProductUiMissingFile Include="@(_RustyEngineProductUiBuiltFile)"
                                        Condition="!Exists('%(Identity)')" />
    </ItemGroup>
    <Delete Files="$(_RustyEngineProductUiBuildStamp)"
            Condition="'@(_RustyEngineProductUiMissingFile)' != ''" />
  </Target>

  <!-- A product with a compiled DOM companion names its command and inputs.
       Ordinary MSBuild incrementality skips the command when no input is
       newer than the last successful build and its outputs exist, so C#-only
       and unchanged builds do not recompile the UI. -->
  <Target Name="BuildRustyEngineProductUi"
          Condition="'$(RustyEngineProductUiBuildCommand)' != ''"
          DependsOnTargets="_CheckRustyEngineProductUiOutputs"
          Inputs="@(RustyEngineProductUiInput);$(MSBuildProjectFullPath)"
          Outputs="$(_RustyEngineProductUiBuildStamp);$(RustyEngineProductUiRoot)/$(RustyEngineProductUiEntry)">
    <MakeDir Directories="$(RustyEngineProductUiRoot)" />
    <Exec Command="$(RustyEngineProductUiBuildCommand)" />
    <ItemGroup>
      <_RustyEngineProductUiOutput Include="$(RustyEngineProductUiRoot)/**/*" />
    </ItemGroup>
    <WriteLinesToFile File="$(_RustyEngineProductUiBuildStamp)"
                      Lines="@(_RustyEngineProductUiOutput->'%(FullPath)')"
                      Overwrite="true" />
  </Target>

  <!-- UI and content only. `rusty dev` runs this alone for UI or bundle
       content edits and asks the running runtime to reload them, so no C#
       build and no runtime replacement happen. -->
  <Target Name="StageRustyEngineProductAssets"
          DependsOnTargets="BuildRustyEngineProductUi">
    <Error Condition="!Exists('$(RustyEngineProductUiRoot)')"
           Text="RustyEngineProductUiRoot does not exist: $(RustyEngineProductUiRoot)" />
    <Error Condition="!Exists('$(RustyEngineProductContentRoot)')"
           Text="RustyEngineProductContentRoot does not exist: $(RustyEngineProductContentRoot)" />
    <MakeDir Directories="$(RustyEngineStagedProductDirectory)/ui/$(RustyEngineProductUiAssets);$(RustyEngineStagedProductDirectory)/content" />
    <ItemGroup>
      <_RustyEngineUiFiles Include="$(RustyEngineProductUiRoot)/**/*" />
      <_RustyEngineContentFiles Include="$(RustyEngineProductContentRoot)/**/*" />
      <_RustyEngineStagedUiFiles Include="@(_RustyEngineUiFiles->'$(RustyEngineStagedProductDirectory)/ui/%(RecursiveDir)%(Filename)%(Extension)')" />
      <_RustyEngineStagedContentFiles Include="@(_RustyEngineContentFiles->'$(RustyEngineStagedProductDirectory)/content/%(RecursiveDir)%(Filename)%(Extension)')" />
      <_RustyEngineRemovedStagedFiles Include="$(RustyEngineStagedProductDirectory)/ui/**/*;$(RustyEngineStagedProductDirectory)/content/**/*"
                                      Exclude="@(_RustyEngineStagedUiFiles);@(_RustyEngineStagedContentFiles)" />
    </ItemGroup>
    <!-- Unchanged UI and content (same size and timestamp) are not copied again. -->
    <Delete Files="@(_RustyEngineRemovedStagedFiles)" />
    <Copy SourceFiles="@(_RustyEngineUiFiles)"
          DestinationFiles="@(_RustyEngineStagedUiFiles)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_RustyEngineContentFiles)"
          DestinationFiles="@(_RustyEngineStagedContentFiles)"
          SkipUnchangedFiles="true" />
    <RustyEngineContentBundleManifestTask
        Condition="'@(RustyEngineContentBundle)' != ''"
        ContentRoot="$(RustyEngineProductContentRoot)"
        StagedContentRoot="$(RustyEngineStagedProductDirectory)/content"
        Bundles="@(RustyEngineContentBundle)" />
  </Target>

  <!-- A bundle lists exactly the runtime artifacts staged by this invocation.
       Each artifact target removes product.json first, and
       _RustyEngineWriteProductManifest writes it last, so a host admits a
       complete bundle or none. A running runtime maps its assemblies or
       module until it is replaced: each artifact gets fresh files instead of
       rewriting mapped ones in place. Build and publish output is never
       loaded, so the next build may overwrite it. -->
  <Target Name="_RustyEngineStageCoreClrAssemblies"
          DependsOnTargets="ValidateRustyEngineProduct;Build">
    <Delete Files="$(RustyEngineStagedProductDirectory)/product.json" />
    <RemoveDir Directories="$(RustyEngineStagedProductDirectory)/coreclr" />
    <MakeDir Directories="$(RustyEngineStagedProductDirectory)/coreclr" />
    <ItemGroup>
      <_RustyEngineCoreClrOutputFiles Include="$(OutDir)**/*" />
    </ItemGroup>
    <Copy SourceFiles="@(_RustyEngineCoreClrOutputFiles)"
          DestinationFiles="@(_RustyEngineCoreClrOutputFiles->'$(RustyEngineStagedProductDirectory)/coreclr/%(RecursiveDir)%(Filename)%(Extension)')" />
    <PropertyGroup>
      <_RustyEngineManifestCoreClr>,&quot;coreclr&quot;:{&quot;assembly&quot;:&quot;coreclr/$(TargetFileName)&quot;,&quot;runtimeconfig&quot;:&quot;coreclr/$(TargetName).runtimeconfig.json&quot;}</_RustyEngineManifestCoreClr>
    </PropertyGroup>
  </Target>

  <!-- NativeAOT publishes this product project as a shared library; nothing
       is built or staged for CoreCLR. The RID keeps the publish's intermediate
       and output directories apart from the CoreCLR build. Its RID-specific
       restore writes to its own extensions path in every project of the graph
       (Rusty.Engine.NativeAotRestore.props): sharing obj/project.assets.json
       with the CoreCLR restore made each restore invalidate the other's build,
       and one path for the whole graph mixed projects' restore assets. -->
  <Target Name="_RustyEngineStageNativeAotModule"
          DependsOnTargets="ValidateRustyEngineProduct">
    <Error Condition="'$(RustyEngineNativeAotRuntimeIdentifier)' != 'linux-x64'"
           Text="VerifyRustyEngineAot currently proves the supported linux-x64 NativeAOT module; set RustyEngineNativeAotRuntimeIdentifier=linux-x64." />
    <!-- NuGet restore evaluates a project without its package imports, so it
         never sees the source override's ProjectReferences above; restore
         them for this publish's own extensions path first. -->
    <Exec Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'"
          Command="dotnet restore &quot;$(RustyEngineSourceDevelopmentPath)/csharp/Rusty.Engine/Rusty.Engine.csproj&quot; --runtime &quot;$(RustyEngineNativeAotRuntimeIdentifier)&quot; &quot;-p:CustomBeforeDirectoryBuildProps=$(MSBuildThisFileDirectory)Rusty.Engine.NativeAotRestore.props&quot;" />
    <Exec Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'"
          Command="dotnet restore &quot;$(RustyEngineSourceDevelopmentPath)/csharp/Rusty.Engine.ProductGenerator/Rusty.Engine.ProductGenerator.csproj&quot; &quot;-p:CustomBeforeDirectoryBuildProps=$(MSBuildThisFileDirectory)Rusty.Engine.NativeAotRestore.props&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildProjectFullPath)&quot; --configuration &quot;$(Configuration)&quot; --runtime &quot;$(RustyEngineNativeAotRuntimeIdentifier)&quot; --output &quot;$(_RustyEngineNativeAotOutputDirectory)&quot; -p:PublishAot=true -p:NativeLib=Shared -p:InvariantGlobalization=true -p:StripSymbols=true &quot;-p:CustomBeforeDirectoryBuildProps=$(MSBuildThisFileDirectory)Rusty.Engine.NativeAotRestore.props&quot; &quot;-p:RustyEngineUseSourceDevelopment=$(RustyEngineUseSourceDevelopment)&quot; &quot;-p:RustyEngineSourceDevelopmentPath=$(RustyEngineSourceDevelopmentPath)&quot;" />
    <Error Condition="!Exists('$(_RustyEngineNativeAotOutputDirectory)/$(_RustyEngineProductNativeModule)')"
           Text="NativeAOT publish did not produce $(_RustyEngineProductNativeModule)." />
    <Delete Files="$(RustyEngineStagedProductDirectory)/product.json" />
    <RemoveDir Directories="$(RustyEngineStagedProductDirectory)/native" />
    <MakeDir Directories="$(RustyEngineStagedProductDirectory)/native" />
    <Copy SourceFiles="$(_RustyEngineNativeAotOutputDirectory)/$(_RustyEngineProductNativeModule)"
          DestinationFolder="$(RustyEngineStagedProductDirectory)/native" />
    <PropertyGroup>
      <_RustyEngineManifestNativeAot>,&quot;nativeAot&quot;:{&quot;module&quot;:&quot;native/$(_RustyEngineProductNativeModule)&quot;}</_RustyEngineManifestNativeAot>
    </PropertyGroup>
  </Target>

  <Target Name="_RustyEngineWriteProductManifest">
    <PropertyGroup>
      <_RustyEngineManifestIntents>@(RustyEngineProductInputIntent-&gt;'{&quot;id&quot;:&quot;%(Identity)&quot;,&quot;value&quot;:&quot;%(Value)&quot;}', ',')</_RustyEngineManifestIntents>
      <_RustyEngineManifestMappings>@(RustyEngineProductInputMapping-&gt;'{&quot;id&quot;:&quot;%(Identity)&quot;,&quot;intent&quot;:&quot;%(Intent)&quot;,&quot;trigger&quot;:&quot;%(Trigger)&quot;}', ',')</_RustyEngineManifestMappings>
    </PropertyGroup>
    <ItemGroup>
      <_RustyEngineManifestUiContentPath Include="@(RustyEngineProductUiContent)"
                                         Path="$([System.String]::Copy('%(Identity)').Replace('%5C', '/'))" />
    </ItemGroup>
    <PropertyGroup>
      <_RustyEngineManifestUiContent>@(_RustyEngineManifestUiContentPath-&gt;'&quot;%(Path)&quot;', ',')</_RustyEngineManifestUiContent>
    </PropertyGroup>
    <WriteLinesToFile File="$(RustyEngineStagedProductDirectory)/product.json" Overwrite="true"
                      Lines="{&quot;artifact&quot;:&quot;rusty.product.bundle&quot;,&quot;schemaVersion&quot;:1,&quot;product&quot;:{&quot;id&quot;:&quot;$(RustyEngineProductId)&quot;,&quot;title&quot;:&quot;$(RustyEngineProductTitle)&quot;}$(_RustyEngineManifestNativeAot)$(_RustyEngineManifestCoreClr),&quot;ui&quot;:{&quot;root&quot;:&quot;ui&quot;,&quot;entry&quot;:&quot;$(RustyEngineProductUiEntry)&quot;,&quot;assets&quot;:&quot;$(RustyEngineProductUiAssets)&quot;},&quot;content&quot;:{&quot;root&quot;:&quot;content&quot;,&quot;ui&quot;:[$(_RustyEngineManifestUiContent)]},&quot;lifecycle&quot;:{&quot;fixedStep&quot;:{&quot;hz&quot;:$(RustyEngineProductFixedStepHz),&quot;maxCatchUpSteps&quot;:$(RustyEngineProductFixedStepMaxCatchUpSteps)}},&quot;input&quot;:{&quot;cursorMode&quot;:&quot;$(RustyEngineProductInputCursorMode)&quot;,&quot;intents&quot;:[$(_RustyEngineManifestIntents)],&quot;mappings&quot;:[$(_RustyEngineManifestMappings)]}$(_RustyEngineManifestUiProjection),&quot;renderer&quot;:{&quot;output&quot;:&quot;$(RustyEngineProductRenderOutput)&quot;$(_RustyEngineManifestPresentationAspect),&quot;gpuCulling&quot;:&quot;$(RustyEngineProductGpuCulling)&quot;,&quot;antialiasing&quot;:&quot;$(RustyEngineProductAntialiasing)&quot;,&quot;vsync&quot;:&quot;$(RustyEngineProductVsync)&quot;,&quot;renderScale&quot;:$(RustyEngineProductRenderScale),&quot;lighting&quot;:{&quot;shadows&quot;:&quot;$(RustyEngineProductSceneShadows)&quot;,&quot;shadowBudget&quot;:$(RustyEngineProductShadowBudget),&quot;ambientOcclusion&quot;:{&quot;mode&quot;:&quot;$(RustyEngineProductAmbientOcclusion)&quot;,&quot;strength&quot;:$(RustyEngineProductAmbientOcclusionStrength),&quot;radius&quot;:$(RustyEngineProductAmbientOcclusionRadius)},&quot;clusteredLighting&quot;:&quot;$(RustyEngineProductClusteredLighting)&quot;,&quot;volumetricFog&quot;:&quot;$(RustyEngineProductVolumetricFog)&quot;,&quot;defaultLights&quot;:{&quot;world&quot;:&quot;$(RustyEngineProductDefaultWorldLights)&quot;,&quot;viewmodel&quot;:&quot;$(RustyEngineProductDefaultViewmodelLights)&quot;}}},&quot;audio&quot;:{&quot;output&quot;:&quot;$(RustyEngineProductAudioOutput)&quot;},&quot;server&quot;:{&quot;bindHost&quot;:&quot;$(RustyEngineProductBindHost)&quot;,&quot;port&quot;:$(RustyEngineProductPort),&quot;liveDebug&quot;:$(RustyEngineProductLiveDebug)}}" />
  </Target>

  <!-- The directories of the projects the product references, directly or
       transitively (the .NET SDK adds transitive references to
       ProjectReference), are C# sources too. `rusty dev` reads the property
       after staging. The Engine projects a source-development override
       references are not product sources. -->
  <Target Name="_RustyEngineWatchReferencedProjects"
          Condition="'$(_RustyEngineWatchReferencedProjects)' == 'true'"
          DependsOnTargets="IncludeTransitiveProjectReferences">
    <PropertyGroup>
      <_RustyEngineSourceDevelopmentProjects Condition="'$(RustyEngineUseSourceDevelopment)' == 'true' and '$(RustyEngineSourceDevelopmentPath)' != ''">$([MSBuild]::NormalizeDirectory('$(RustyEngineSourceDevelopmentPath)', 'csharp'))</_RustyEngineSourceDevelopmentProjects>
    </PropertyGroup>
    <ItemGroup>
      <_RustyEngineReferencedProject Include="@(ProjectReference->'%(FullPath)')" />
      <_RustyEngineReferencedProject Remove="@(_RustyEngineReferencedProject)"
                                     Condition="'$(_RustyEngineSourceDevelopmentProjects)' != '' and $([System.String]::Copy('%(Identity)').StartsWith('$(_RustyEngineSourceDevelopmentProjects)'))" />
    </ItemGroup>
    <PropertyGroup>
      <RustyEngineWatchPaths>$(RustyEngineWatchPaths);@(_RustyEngineReferencedProject->DirectoryName()->Distinct())</RustyEngineWatchPaths>
    </PropertyGroup>
  </Target>

  <!-- CoreCLR is the normal, explicit staging operation used by development. -->
  <Target Name="StageRustyEngineCoreClrProduct"
          DependsOnTargets="_RustyEngineStageCoreClrAssemblies;StageRustyEngineProductAssets;_RustyEngineWriteProductManifest;_RustyEngineWatchReferencedProjects">
    <Message Importance="High" Text="Rusty Engine CoreCLR Product staged at $(RustyEngineStagedProductDirectory)" />
  </Target>

  <!-- NativeAOT is an opt-in fidelity/release operation. It does not build or
       stage CoreCLR. -->
  <Target Name="VerifyRustyEngineAot"
          DependsOnTargets="_RustyEngineStageNativeAotModule;StageRustyEngineProductAssets;_RustyEngineWriteProductManifest">
    <Message Importance="High" Text="Rusty Engine linux-x64 NativeAOT Product staged at $(RustyEngineStagedProductDirectory)" />
  </Target>

  <!-- One bundle that either loader can run, for comparing them. -->
  <Target Name="StageRustyEngineCombinedProduct"
          DependsOnTargets="_RustyEngineStageCoreClrAssemblies;_RustyEngineStageNativeAotModule;StageRustyEngineProductAssets;_RustyEngineWriteProductManifest">
    <Message Importance="High" Text="Rusty Engine CoreCLR and NativeAOT Product staged at $(RustyEngineStagedProductDirectory)" />
  </Target>
</Project>

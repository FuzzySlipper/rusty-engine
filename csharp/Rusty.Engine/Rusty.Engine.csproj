<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="obj/Generated/EngineContracts.g.cs" Visible="false" />
    <Compile Include="obj/Generated/EngineValues.g.cs" Visible="false" />
  </ItemGroup>
  <Target Name="GenerateEngineContracts" BeforeTargets="CoreCompile">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)../../scripts/generate-csharp-native-bindings.sh&quot; &quot;$(MSBuildProjectDirectory)/obj/Generated&quot;" />
  </Target>
</Project>

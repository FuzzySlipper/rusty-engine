<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsRoslynComponent>true</IsRoslynComponent>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <RustyEngineGeneratedBindingsDir Condition="'$(RustyEngineGeneratedBindingsDir)' == ''">$(MSBuildProjectDirectory)/obj/Generated</RustyEngineGeneratedBindingsDir>
    <RustyEngineGeneratedInputsDir Condition="'$(RustyEngineGeneratedInputsDir)' == ''">$(MSBuildProjectDirectory)/obj/GeneratedInputs</RustyEngineGeneratedInputsDir>
    <RustyEngineGenerateBindings Condition="'$(RustyEngineGenerateBindings)' == ''">true</RustyEngineGenerateBindings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(RustyEngineGeneratedInputsDir)/Interop.g.cs" LogicalName="Rusty.Engine.ProductGenerator.GeneratedInputs.Interop.g.cs" />
    <EmbeddedResource Include="$(RustyEngineGeneratedInputsDir)/EngineServiceImplementations.g.cs" LogicalName="Rusty.Engine.ProductGenerator.GeneratedInputs.EngineServiceImplementations.g.cs" />
    <EmbeddedResource Include="$(RustyEngineGeneratedInputsDir)/AbiIdentity.g.cs" LogicalName="Rusty.Engine.ProductGenerator.GeneratedInputs.AbiIdentity.g.cs" />
  </ItemGroup>
  <Target Name="GenerateNativeProductInputs" BeforeTargets="PrepareResources" Condition="'$(RustyEngineGenerateBindings)' == 'true'">
    <Exec Command="&quot;$(MSBuildThisFileDirectory)../../scripts/generate-csharp-native-bindings.sh&quot; &quot;$(RustyEngineGeneratedBindingsDir)&quot; &quot;$(RustyEngineGeneratedInputsDir)&quot;" />
  </Target>
</Project>

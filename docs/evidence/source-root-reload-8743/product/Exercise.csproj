<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>SourceRootReload.Product</RustyEngineProductEntryType>
    <RustyEngineProductId>source-root-reload</RustyEngineProductId>
    <RustyEngineProductTitle>Source-root reload exercise</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/ui/generated</RustyEngineProductUiRoot>
    <RustyEngineProductUiSourceRoot>$(MSBuildProjectDirectory)/ui</RustyEngineProductUiSourceRoot>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/content</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <!-- The exercise logs each compiler invocation before running it. -->
    <RustyEngineProductUiBuildCommand>echo "tsc $([System.DateTime]::Now.Ticks)" &gt;&gt; "$(MSBuildProjectDirectory)/tsc-invocations.log" &amp;&amp; "$(ExerciseTsc)" --project "$(MSBuildProjectDirectory)/ui/tsconfig.json"</RustyEngineProductUiBuildCommand>
    <RustyEngineWatchPaths>$(MSBuildProjectDirectory)/Product.cs;$(MSBuildProjectDirectory)/ui;$(MSBuildProjectDirectory)/content</RustyEngineWatchPaths>
  </PropertyGroup>
  <ItemGroup>
    <RustyEngineContentBundle Include="notes" />
    <PackageReference Include="Rusty.Engine" Version="$(ExerciseSdkVersion)" />
  </ItemGroup>
</Project>

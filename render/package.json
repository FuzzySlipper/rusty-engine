{
  "name": "rusty-engine-render",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "pnpm run build:packages && pnpm run bundle:application-host-artifact && pnpm run build:webview-artifact",
    "build:packages": "pnpm -r build",
    "build:application-host-artifact": "pnpm --filter @rusty-engine/application-host run build && vite build --config vite.application-host.config.ts && node scripts/publish-application-host-artifact.mjs",
    "bundle:application-host-artifact": "vite build --config vite.application-host.config.ts && node scripts/publish-application-host-artifact.mjs",
    "build:webview-artifact": "vite build --config vite.webview.config.ts",
    "boundary": "node scripts/check-boundaries.mjs && node scripts/check-product-playtest-fixture.mjs && node scripts/generate-developer-command-contract.mjs --check && node scripts/verify-developer-command-artifacts.mjs",
    "typecheck": "tsc --build packages/*/tsconfig.json && tsc --project tsconfig.browser.json --noEmit",
    "typecheck:browser": "tsc --project tsconfig.browser.json --noEmit",
    "test": "pnpm -r test",
    "test:compiled": "pnpm -r test:compiled",
    "test:browser": "playwright test --config playwright.config.ts",
    "verify": "pnpm run boundary && pnpm run build && pnpm run typecheck:browser && pnpm run test:compiled && pnpm run test:browser"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@rusty-engine/application-host": "workspace:*",
    "@rusty-engine/render-contracts": "workspace:*",
    "@rusty-engine/renderer-host": "workspace:*",
    "@rusty-engine/renderer-three": "workspace:*",
    "@types/node": "^25.0.0",
    "@types/three": "^0.184.1",
    "three": "^0.184.0",
    "typescript": "^5.9.3",
    "vite": "^8.1.5"
  }
}

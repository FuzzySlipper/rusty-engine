{
  "name": "@rusty-engine/renderer-host",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc --build",
    "prepare": "pnpm run build",
    "typecheck": "tsc --build",
    "test": "tsc --build && pnpm run test:compiled",
    "test:compiled": "node --test 'dist/**/*.test.js'"
  },
  "peerDependencies": {
    "@rusty-engine/render-contracts": "0.1.0",
    "@rusty-engine/render-projection": "0.1.0",
    "@rusty-engine/renderer-three": "0.1.0"
  },
  "devDependencies": {
    "@rusty-engine/render-contracts": "workspace:*",
    "@rusty-engine/render-projection": "workspace:*",
    "@rusty-engine/renderer-three": "workspace:*",
    "@types/node": "^24.0.0"
  }
}

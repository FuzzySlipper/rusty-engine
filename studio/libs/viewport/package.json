{
  "name": "@rusty-engine/studio-viewport",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "prebuild": "pnpm --dir ../.. run build:renderer",
    "build": "tsc --project tsconfig.build.json",
    "pretypecheck": "pnpm --dir ../.. run build:renderer",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@angular/core": "~21.2.0",
    "@rusty-engine/render-contracts": "link:../../../render/packages/render-contracts",
    "@rusty-engine/render-projection": "link:../../../render/packages/render-projection",
    "@rusty-engine/renderer-host": "link:../../../render/packages/renderer-host",
    "@rusty-engine/renderer-three": "link:../../../render/packages/renderer-three"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  }
}

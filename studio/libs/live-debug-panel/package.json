{
  "name": "@rusty-engine/live-debug-panel",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "prebuild": "pnpm --dir ../.. --filter @rusty-engine/live-debug-client run build",
    "build": "ngc --project tsconfig.build.json",
    "prepare": "pnpm run build",
    "pretypecheck": "pnpm --dir ../.. --filter @rusty-engine/live-debug-client run build",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "pnpm run build && node --test 'dist/**/*.test.js'"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/forms": "~21.2.0"
  },
  "peerDependencies": {
    "@rusty-engine/live-debug-client": "0.1.0"
  },
  "devDependencies": {
    "@rusty-engine/live-debug-client": "workspace:*",
    "@types/node": "^24.0.0"
  }
}

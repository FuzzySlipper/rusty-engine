{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@rusty-engine/studio-adapter-client": ["libs/adapter-client/src/index.ts"],
      "@rusty-engine/studio-editor-shell": ["libs/editor-shell/src/index.ts"],
      "@rusty-engine/studio-viewport": ["libs/viewport/src/index.ts"]
    }
  },
  "include": ["apps", "libs", "test", "scripts/**/*.ts", "scripts/**/*.mjs"]
}

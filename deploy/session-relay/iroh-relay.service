# systemd unit for the session relay. Install the binary with
#   cargo install iroh-relay --version 1.3.0 --features server --locked --root /usr/local
# and the configuration as /etc/iroh-relay/relay.toml.
[Unit]
Description=Rusty Engine session relay (iroh-relay 1.3)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/iroh-relay --config-path /etc/iroh-relay/relay.toml
WorkingDirectory=/var/lib/iroh-relay
StateDirectory=iroh-relay
DynamicUser=yes
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <NativeLib>Shared</NativeLib>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <RustyEngineProductEntryType>CsharpNativeAotTrial.Product</RustyEngineProductEntryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../csharp/Rusty.Engine/Rusty.Engine.csproj" />
    <ProjectReference Include="../../csharp/Rusty.Engine.ProductGenerator/Rusty.Engine.ProductGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="RustyEngineProductEntryType" />
  </ItemGroup>
</Project>

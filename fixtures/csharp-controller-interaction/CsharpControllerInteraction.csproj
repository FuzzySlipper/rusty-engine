<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustyEngineSdkPackageVersion>$(RustyEngineFixtureSdkVersion)</RustyEngineSdkPackageVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <RustyEngineProductEntryType>CsharpControllerInteraction.Product</RustyEngineProductEntryType>
    <RustyEngineProductId>csharp-controller-interaction</RustyEngineProductId>
    <RustyEngineProductTitle>Controller Interaction</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/product-ui</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/content</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>controller-interaction</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>controller-interaction.panel.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>realtime</RustyEngineProductLifecycleMode>
    <RustyEngineProductFixedStepHz>60</RustyEngineProductFixedStepHz>
    <RustyEngineProductFixedStepMaxCatchUpSteps>4</RustyEngineProductFixedStepMaxCatchUpSteps>
    <RustyEngineStagedProductDirectory>$(MSBuildProjectDirectory)/obj/Rusty.Engine/Product</RustyEngineStagedProductDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="$(RustyEngineFixtureSdkVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <RustyEngineProductInputIntent Include="container.close" Value="digital" />
    <RustyEngineProductInputIntent Include="container.take" Value="payload:controller-interaction.take.v1" />
    <RustyEngineProductInputMapping Include="container.close.escape" Intent="container.close" Trigger="key:escape:pressed" />
  </ItemGroup>
</Project>

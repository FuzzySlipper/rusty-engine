<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Description>NativeAOT fidelity proof for the JSON product-state codec: source-generated metadata only, no reflection.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../csharp/Rusty.Engine/Rusty.Engine.csproj" />
  </ItemGroup>
</Project>

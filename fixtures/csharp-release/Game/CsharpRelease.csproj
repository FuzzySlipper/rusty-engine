<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RustyEngineSdkPackageVersion>$(RustyEngineFixtureSdkVersion)</RustyEngineSdkPackageVersion>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RustyEngineProductEntryType>CsharpRelease.Product</RustyEngineProductEntryType>
    <RustyEngineProductId>csharp-release</RustyEngineProductId>
    <RustyEngineProductTitle>Release Fixture</RustyEngineProductTitle>
    <RustyEngineProductLauncherName>ReleaseFixture</RustyEngineProductLauncherName>
    <RustyEngineProductRenderOutput>window</RustyEngineProductRenderOutput>
    <!-- Under rusty dev the tool installs the container here, outside the sources. -->
    <RustyEngineProductInstalledContent>.runtime/installed</RustyEngineProductInstalledContent>
    <RustyEngineProductUiProjectionStream>release</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>release.screen.v1</RustyEngineProductUiProjectionContract>
    <!-- The entry screen is all interface: the pointer stays free for Import. -->
    <RustyEngineProductInputCursorMode>unlocked</RustyEngineProductInputCursorMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="$(RustyEngineFixtureSdkVersion)">
      <ExcludeAssets Condition="'$(RustyEngineUseSourceDevelopment)' == 'true'">compile;runtime</ExcludeAssets>
    </PackageReference>
    <RustyEngineProductTool Include="../ReleaseImport/ReleaseImport.csproj" />
    <RustyEngineProductInputIntent Include="release.import" Value="payload:release.import.v1" />
    <RustyEngineProductInputIntent Include="release.cancel" Value="payload:release.cancel.v1" />
  </ItemGroup>
</Project>

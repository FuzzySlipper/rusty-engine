<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <!-- Loaded as a CoreCLR component by the runtime-pack proof. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Nullable>enable</Nullable>
    <RustyEngineProductEntryType>DebugExecutionContextFixture.FixtureProduct</RustyEngineProductEntryType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../csharp/Rusty.Engine/Rusty.Engine.csproj" />
    <ProjectReference Include="../../csharp/Rusty.Engine.ProductGenerator/Rusty.Engine.ProductGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="RustyEngineProductEntryType" />
  </ItemGroup>
</Project>

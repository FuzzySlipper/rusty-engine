<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>

    <!-- This fixture consumes the public SDK's generated staging targets while
         explicitly opting into the checked-out Engine implementation. -->
    <RustyEngineFixtureSdkVersion Condition="'$(RustyEngineFixtureSdkVersion)' == ''">$(RUSTY_ENGINE_FIXTURE_SDK_VERSION)</RustyEngineFixtureSdkVersion>
    <RustyEngineUseSourceDevelopment>true</RustyEngineUseSourceDevelopment>
    <RustyEngineSourceDevelopmentPath>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)/../..'))</RustyEngineSourceDevelopmentPath>
    <RustyEngineSdkPackageVersion>$(RustyEngineFixtureSdkVersion)</RustyEngineSdkPackageVersion>
    <RustyEngineProductEntryType>CsharpCrossoverPerformance.Product</RustyEngineProductEntryType>
    <RustyEngineProductId>csharp-crossover-performance</RustyEngineProductId>
    <RustyEngineProductTitle>C# Crossover Performance</RustyEngineProductTitle>
    <RustyEngineProductUiRoot>$(MSBuildProjectDirectory)/product-ui</RustyEngineProductUiRoot>
    <RustyEngineProductContentRoot>$(MSBuildProjectDirectory)/content</RustyEngineProductContentRoot>
    <RustyEngineProductUiEntry>main.js</RustyEngineProductUiEntry>
    <RustyEngineProductUiProjectionStream>crossover-performance</RustyEngineProductUiProjectionStream>
    <RustyEngineProductUiProjectionContract>crossover.performance.v1</RustyEngineProductUiProjectionContract>
    <RustyEngineProductLifecycleMode>demand</RustyEngineProductLifecycleMode>
    <RustyEngineStagedProductDirectory>$(MSBuildProjectDirectory)/obj/Rusty.Engine/Product</RustyEngineStagedProductDirectory>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Rusty.Engine" Version="$(RustyEngineFixtureSdkVersion)" ExcludeAssets="compile;runtime" />
  </ItemGroup>
</Project>
